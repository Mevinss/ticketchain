    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.1",
    "ganache": "7.9.2",
    "prettier": "3.6.2",
    "solc": "0.8.24",
    "typescript": "5.8.3",
